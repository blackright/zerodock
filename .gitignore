# Local planning, agent configuration and maintainer-only automation
/project-features*
/project-feautures*
/.agents/
/.codex/
/Phase-Builder-Agent.md
/Specs-Dafting.md
/Troubleshoot.md
/scripts/review_pr.py

# Publish the governance document, not local Spec Kit state or agent machinery
/.specify/*
!/.specify/memory/
/.specify/memory/*
!/.specify/memory/constitution.md

# Publish the reviewed feature/follow-up documents, not unrelated private drafts
/specs/*
!/specs/README.md
!/specs/003-handler-hot-reload/
!/specs/004-performance-remediation/

# Keep human-readable evidence summaries; exclude all generated verification data
/specs/*/verification/*
!/specs/003-handler-hot-reload/verification/*.md
!/specs/004-performance-remediation/verification/*.md

# Runtime storage, temporary state and local caches
.zerodock/
.cache/
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.dll
*.dylib

# Python environments
.venv*/
venv/
ENV/
env/
env.bak/
venv.bak/

# Tests, coverage, profiling, lint and type-checker outputs
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.benchmarks/
.coverage
.coverage.*
coverage.xml
*.cover
*.prof
*.pstats
htmlcov/
.nox/
.tox/

# Distribution and build artifacts
build/
dist/
*.egg-info/
*.egg
eggs/
.eggs/
*.whl

# Secrets and local credentials; publish only deliberately reviewed examples
.env
.env.*
!.env.example
!.env.sample
!.env.template
.aws/
.azure/
.gcloud/
.netrc
.pypirc
*.pem
*.key
*.p12
*.pfx
*.jks

# Logs and editor/OS state
*.log
.vscode/*
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
